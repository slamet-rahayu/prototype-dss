# Port & Node Environment
PORT=3000
NODE_ENV=development

# Database Connection String (PostgreSQL)
# Ganti dengan kredensial PostgreSQL lokal jika terpasang
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dss_career_db?schema=public"

# Keamanan JWT
JWT_SECRET="sangat_rahasia_dan_panjang_kunci_jwt_signature_key_2026_dss_ta"
JWT_EXPIRES_IN="7d"

# Cron Settings
MARKET_CRON_EXPRESSION="0 2 * * *"

# External Job Portal API
JOB_PORTAL="http://localhost:8000/api/jobs"
JOB_PORTAL_API="http://localhost:8000/api/jobs"
NEXT_PUBLIC_JOB_PORTAL_API="http://localhost:8000/api/jobs"

# O*NET Web Services API
ONET_WEB_SERVICE_API="https://api-v2.onetcenter.org"
ONET_XAPI_KEY="your-onet-web-services-api-key"
