datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum RiasecDimension {
  R
  I
  A
  S
  E
  C
}

model User {
  id           String                  @id @default(uuid())
  email        String                  @unique
  passwordHash String
  role         Role                    @default(STUDENT)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  student      Student?
  histories    RecommendationHistory[]
}

model Student {
  id           String          @id @default(uuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  nim          String          @unique
  fullName     String
  university   String          @default("Universitas Esa Unggul")
  studyProgram String          @default("Teknologi Informasi")
  semester     String          @default("Semester 7")
  domicile     String          @default("Jakarta, Indonesia")
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  grades       AcademicGrade[]
  riasecResult RiasecResult?
}

model AcademicSubject {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  description   String
  icon          String                 @default("⌘")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  grades        AcademicGrade[]
  careerWeights CareerAcademicWeight[]
}

model AcademicGrade {
  id           String          @id @default(uuid())
  studentId    String
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    Int
  subject      AcademicSubject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  grade        Float
  status       String
  semester     String
  academicYear String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([studentId, subjectId])
}

model RiasecQuestion {
  id        Int             @id @default(autoincrement())
  type      RiasecDimension
  question  String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
}

model RiasecResult {
  id          String   @id @default(uuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scoreR      Int      @default(0)
  scoreI      Int      @default(0)
  scoreA      Int      @default(0)
  scoreS      Int      @default(0)
  scoreE      Int      @default(0)
  scoreC      Int      @default(0)
  topHolland  String
  answersJson Json
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Career {
  id                String                 @id @default(uuid())
  slug              String                 @unique
  title             String                 @unique
  subtitle          String
  description       String
  icon              String                 @default("⌘")
  jobMarketKeyword  String?
  marketDemandScore Float                  @default(80.0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  marketDetail      JobMarketDetail?
  riasecWeights     CareerRiasecWeight[]
  academicWeights   CareerAcademicWeight[]
}

model JobMarketDetail {
  id               String   @id @default(uuid())
  careerId         String   @unique
  career           Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  jobMarketKeyword String?
  vacancyCount     Int      @default(0)
  trendStatus      String   @default("Tren meningkat")
  primaryLocation  String   @default("Jakarta, Bandung, dan Remote")
  requiredSkills   Json
  shortNote        String?
  updatedAt        DateTime @updatedAt
}

model CareerRiasecWeight {
  id        String          @id @default(uuid())
  careerId  String
  career    Career          @relation(fields: [careerId], references: [id], onDelete: Cascade)
  dimension RiasecDimension
  weight    Float

  @@unique([careerId, dimension])
}

model CareerAcademicWeight {
  id        String          @id @default(uuid())
  careerId  String
  career    Career          @relation(fields: [careerId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   AcademicSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weight    Float

  @@unique([careerId, subjectId])
}

model SawConfig {
  id        Int      @id @default(1)
  c1Weight  Float    @default(40.0)
  c2Weight  Float    @default(35.0)
  c3Weight  Float    @default(25.0)
  isActive  Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model RecommendationHistory {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hollandCode   String
  topCareerName String
  highestScore  Float
  status        String   @default("Valid")
  fullResult    Json
  calculatedAt  DateTime @default(now())
}

model SchedulerLog {
  id            Int      @id @default(autoincrement())
  jobName       String
  executionType String
  status        String
  processed     Int
  successCount  Int
  failedCount   Int
  durationSec   Float
  message       String
  startedAt     DateTime @default(now())
  finishedAt    DateTime
}

model SchedulerConfig {
  id             String    @id @default(uuid())
  careerId       String?
  careerName     String
  cronExpression String    @default("0 2 * * *")
  executionTime  String    @default("02.00")
  timezone       String    @default("Asia/Jakarta")
  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  lastRunAt      DateTime?
  lastStatus     String?   @default("Berhasil")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
